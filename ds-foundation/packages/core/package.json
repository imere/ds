{
  "name": "@ds/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design System 底层：token / class / theme 的纯逻辑层，不碰 DOM，IE10 安全",
  "types": "build/index.d.ts",
  "main": "build/index.umd.cjs",
  "module": "build/index.js",
  "browser": "build/index.js",
  "unpkg": "build/index.umd.cjs",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.umd.cjs",
      "default": "./build/index.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c ../../rollup.config.js --environment PKG:core"
  },
  "keywords": [
    "design-system",
    "design-token",
    "theme",
    "ie10"
  ],
  "license": "MIT"
}
