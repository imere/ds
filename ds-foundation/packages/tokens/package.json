{
  "name": "@ds/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "官方设计令牌集：明暗主题、强调色板、派生种子、断点与工具类尺度。机制在 @ds/core，值在这里",
  "types": "dist/index.d.ts",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "browser": "dist/index.js",
  "unpkg": "dist/index.umd.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs",
      "default": "./dist/index.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c ../../rollup.config.js --environment PKG:tokens"
  },
  "keywords": [
    "design-system",
    "design-token",
    "theme",
    "ie10"
  ],
  "license": "MIT",
  "dependencies": {
    "@ds/core": "workspace:*"
  }
}
