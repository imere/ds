  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "packages",
    "outDir": ".types"
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "**/build/**"]
}
