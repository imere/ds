{
  "name": "@ds/vue2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design System 底层：Vue 2 绑定层（install / 响应式令牌 / 主题指令）",
  "types": "build/index.d.ts",
  "main": "build/index.umd.cjs",
  "module": "build/index.js",
  "browser": "build/index.js",
  "unpkg": "build/index.umd.cjs",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.umd.cjs",
      "default": "./build/index.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "rollup -c ../../rollup.config.js --environment PKG:vue2"
  },
  "dependencies": {
    "@ds/core": "workspace:*",
    "@ds/dom": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^2.6.0 || ^2.7.0"
  },
  "devDependencies": {
    "vue": "^2.7.16"
  },
  "keywords": [
    "design-system",
    "vue2",
    "theme",
    "ie10"
  ],
  "license": "MIT"
}
