# 这不是格式化的真源 —— 真源是 `eslint.config.js` 里的那份 `prettierOptions`
# （Prettier 只通过 eslint-plugin-prettier 跑：`pnpm run lint` 检查、`lint:fix` 修）。
#
# 它存在的唯一理由是管 ESLint 管不到的那一段：**你敲回车的那一刻**。
# ESLint 只在 lint 时跑，来不及决定「新建文件缩进几格、粘贴进来是什么样子、存盘用什么编码」，
# 那些是编辑器当场做的。所以这里每一项都必须能在 `prettierOptions` 里找到对应项，
# 值是两处共用的 —— **改一边必须同步改另一边**，否则编辑器写进去的样子
# 和 lint 期望的样子会打架（表现为：保存时代码被莫名重排）。

root = true

[*]
charset = utf-8
# 换行符也由 `.gitattributes` 保证，两处口径一致
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Markdown 行尾两个空格是「换行」语义，不能裁 —— Prettier 处理 md 时同样保留
[*.md]
trim_trailing_whitespace = false
