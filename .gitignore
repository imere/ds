# ============================================================
# 规则只有一条：忽略「能随时重建」的东西，源码和 lock 一个不留。
# 依赖能重装、产物能重新构建、示例能重新生成 —— 这些不进版本库。
# ============================================================

# ---- 依赖 ----
node_modules/

# ---- 构建产物 ----
dist/
build/
*.tsbuildinfo
# rollup / vite 的 sourcemap 跟着产物一起，同样不进库
*.map

# ---- 生成的单文件示例 ----
# 由 scripts/inline-examples.mjs 产出，一条命令重建：
#   pnpm run examples:standalone
# 规则要写 **/ 开头：这两个文件在 examples/ 下，
# 不带前缀的话 git 只会拿去匹配仓库根的 examples/，等于没生效
**/examples/*/standalone.html

# ---- 类型声明生成的临时目录 ----
.types/

# ---- 包管理器缓存 ----
# npm 的 _cacache 能有几个 G，而且全是二进制 blob，绝不能进版本库
.npm-cache/
.npm/
.pnpm-store/
.pnpm-debug.log

# ---- 日志 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 环境变量 ----
.env
.env.*
!.env.example

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~
# VS Code：个人配置不入库，但两份「协作约定」要进 —— 它们替–EditorConfig 承担
# 了 Repo 级别的编辑器口径（详见 CONTRIBUTING 的「编辑器接线」），
# 写 `.vscode/*` 而不是 `.vscode/` 是为了让下面两条例外能生效
# （父目录被排除的，子文件就没法再 re-include）
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---- 工具目录 ----
# WorkBuddy 的项目记忆写在这里，是本地工作数据不是源码，不进版本库
# （注意：只是不入库，别删 —— 里面是跨会话的项目约定）
.workbuddy/

# ---- 临时文件 ----
*.tmp
*.temp

# vite 改完配置重启时会生成这种带时间戳的临时 config，正常情况下自己删，
# 进程被强杀才会留在盘上
vite.config.js.timestamp-*

# pnpm 启动时会在 store 里写这种 0 字节临时文件，正常情况自己会删干净，
# 偶尔被中断才留下
_tmp_*

# ---- 构建产物 ----
# 两类，统一叫 build：
#   packages/*/build   每个包自己的 ESM / UMD / d.ts（rollup.config.js、scripts/dts.js）
#   build/             仓库级的产物，目前是 vitest 覆盖率报告（vitest.config.ts）
# 两者都能重建，一条规则盖住；`pnpm run clean` 也是照这两处清的。
build/
# 旧产物目录（改成 build 之前的遗留，盘上若还有也不该进版本库）
dist/
